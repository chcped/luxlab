PORT=8080
HOST=0.0.0.0
ADMIN_API_KEY=SUGB82M7ZqQllmMrEOw7EJq-vW51lTfCX4mqhw8ceHgFyWU7a6Ar3FJ_p3TfqqYQ
JWT_SECRET=RqiTH0uqQ0FL8pr3iNg0sdWIQxAUDy7P5eGgkFBD1W33fg4m3VzmrYync_AsArbKn7oX27qPxMGPB1hYy4jIDA
ALLOWED_ORIGINS=app://desktop,http://localhost:8080,http://127.0.0.1:8080,https://luxlab.net.br
TRUST_PROXY=1
ALLOW_GUESTS=true
MAX_ROOMS=100
MAX_MEMBERS_PER_ROOM=8
ROOM_TTL_SECONDS=14400
# Integra??o JWT externa legada, somente para salas tempor?rias.
# AUTH_JWT_SECRET=outra-chave-forte-do-seu-provedor
AUTH_JWT_ISSUER=luxlab-auth
AUTH_JWT_AUDIENCE=luxlab-desktop
# Configure seu STUN/TURN para conexões fora da rede local.
ICE_SERVERS=[]
# TURN_URLS=turn:turn.seudominio.com:3478,turns:turn.seudominio.com:5349
# TURN_SECRET=segredo-compartilhado-com-o-coturn

# relay exige TURN válido; use all somente para desenvolvimento sem TURN.
ICE_TRANSPORT_POLICY=relay
# debug registra tipos/tamanhos das mensagens; info mantém eventos e métricas.
LOG_LEVEL=debug

# Contas: Resend tem prioridade sobre SMTP. Configure os dois valores.
RESEND_API_KEY=
RESEND_FROM=
# Alternativa: SMTP (sem provedor configurado, login retorna 503).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Docker já define /app/data/luxlab.sqlite. Local: Backend/data/luxlab.sqlite.
# DATABASE_PATH=/app/data/luxlab.sqlite
# Cloudflare Realtime SFU. O secret nunca deve ser enviado aos clientes.
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
