PORT=8080
HOST=0.0.0.0
JWT_SECRET=gere-uma-chave-aleatoria-de-pelo-menos-32-bytes
ALLOWED_ORIGINS=app://desktop,http://localhost:8080,http://127.0.0.1:8080,https://luxlab.net.br
TRUST_PROXY=1
ALLOW_GUESTS=true
MAX_ROOMS=100
MAX_MEMBERS_PER_ROOM=8
