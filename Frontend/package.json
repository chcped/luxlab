{
  "name": "p2p-desktop",
  "version": "0.3.6",
  "private": true,
  "description": "Salas independentes com tela e ?udio do sistema",
  "author": "P2P Desktop",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.mjs",
    "test:turn": "electron scripts/test-turn.cjs",
    "test:turn:load": "node scripts/run-turn-load.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "release": "node scripts/release.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.p2p.desktop",
    "productName": "P2P Desktop",
    "artifactName": "P2P-Desktop-Setup-${version}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "chcped",
      "repo": "luxlab",
      "releaseType": "draft"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "icone.png",
      "logo.png",
      "package.json"
    ],
    "win": {
      "icon": "icone.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "process-audio-capture": "1.0.14"
  },
  "allowScripts": {
    "process-audio-capture@1.0.14": true
  }
}
